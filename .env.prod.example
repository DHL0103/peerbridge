# Django 앱 자체의 설정. 이 파일을 서버에 두는 게 아니라, 이 내용을 GitHub 저장소
# Settings -> Secrets and variables -> Actions 에 ENV_PROD라는 이름의 Secret으로
# 통째로 등록한다.
#
# .github/workflows/deploy.yml이 이미지를 빌드하기 직전에 이 Secret 내용을
# .env.prod 파일로 만들어서 이미지 안에 구워 넣는다 (COPY . . 에 포함됨).

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 로 생성해서 채울 것.
SECRET_KEY=

DEBUG=False

# 콤마로 구분. IP만 있는 단계면 EC2 공인 IP를 그대로 적으면 됨. 도메인 생기면 도메인으로 교체.
ALLOWED_HOSTS=203.0.113.10

# nginx(직접 구성)가 프론트와 같은 origin에서 /api를 백엔드로 프록시해주면 브라우저
# 입장에서 CORS 자체가 발생하지 않아 이 값이 필요 없다. 프론트가 다른 origin에서
# 직접 이 백엔드를 호출하는 구성이면 그 origin을 콤마로 구분해서 채울 것.
CORS_EXTRA_ORIGINS=

# Supabase 프로젝트 -> Settings -> Database -> Connection info 에서 확인.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
