# Django 앱 자체의 설정. 이 파일을 그대로 서버에 두는 게 아니라, 이 내용을
# GitHub 저장소 Settings -> Secrets and variables -> Actions 에 ENV_DOCKER라는
# 이름의 Secret으로 통째로 등록한다.
#
# .github/workflows/deploy.yml이 이미지를 빌드하기 직전에 이 Secret 내용을
# .env.docker 파일로 만들어서 이미지 안에 구워 넣는다 (COPY . . 에 포함됨).
# DB_HOST/DB_PORT는 docker-compose.prod.yml의 web 서비스가 environment:로 직접
# db/3306을 넘겨주므로 여기 안 넣어도 된다.

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 로 생성해서 채울 것.
SECRET_KEY=

DEBUG=False

# 콤마로 구분. IP만 있는 단계면 VPS의 공인 IP를 그대로 적으면 됨. 도메인 생기면 도메인으로 교체.
ALLOWED_HOSTS=203.0.113.10

# 프론트를 VITE_API_BASE_URL="" (상대경로)로 빌드해서 nginx가 같은 origin으로
# /api를 프록시하면 브라우저 입장에서 CORS가 아예 발생하지 않아 이 값이 필요 없다.
# 그 구성을 안 쓰고 프론트를 다른 origin에서 직접 백엔드로 호출하게 할 경우에만 채울 것.
CORS_EXTRA_ORIGINS=

DB_NAME=peerbridge
DB_USER=root
# .env.production의 DB_PASSWORD와 반드시 같은 값이어야 한다 (db 컨테이너의 root
# 비밀번호는 .env.production이, Django가 접속할 때 쓰는 비밀번호는 이 값이 정한다).
DB_PASSWORD=changeme
