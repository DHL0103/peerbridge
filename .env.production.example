# 프로덕션용. VPS에서 cp .env.production.example .env.production 후 값 채우기.
#
# 이 파일은 docker-compose.prod.yml 자체가 쓰는 ${...} 치환값이다 (db 컨테이너 설정,
# ECR 이미지 태그) — Django 앱 안으로는 전달되지 않는다. docker compose는 기본적으로
# 정확히 ".env"라는 이름의 파일만 자동으로 읽으므로, 이 파일을 쓰려면 명령어에
# --env-file .env.production을 꼭 붙여야 한다 (DEPLOY.md 참고).
#
# Django 앱 자체의 설정(SECRET_KEY 등)은 .env.docker.example 참고 — 그건 이 서버가
# 아니라 GitHub Secrets(ENV_DOCKER)에 등록해서 이미지 빌드 시점에 구워 넣는다.

DB_NAME=peerbridge
DB_PASSWORD=changeme
DB_PORT=3306

# CI(.github/workflows/deploy.yml)가 push한 이미지. AWS 계정 ID/리전은 실제 값으로 교체.
ECR_IMAGE=<AWS계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com/peerbridge:latest
