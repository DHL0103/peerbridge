# 프로덕션용. VPS에서 cp .env.production.example .env.production 후 값 채우기.
#
# 이 파일은 두 가지 역할을 겸한다:
#   1. web 컨테이너 안에서 쓰는 환경변수 (env_file:)
#   2. docker-compose.prod.yml 안의 ${DB_PASSWORD} 같은 ${...} 치환값 — docker compose는
#      기본적으로 정확히 ".env"라는 이름의 파일만 자동으로 읽으므로, 이 파일을 쓰려면
#      명령어에 --env-file .env.production을 꼭 붙여야 한다 (DEPLOY.md 참고).

# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 로 생성해서 채울 것 — 절대 이 저장소에 커밋하지 말 것.
SECRET_KEY=

DEBUG=False

# 콤마로 구분. IP만 있는 단계면 VPS의 공인 IP를 그대로 적으면 됨. 도메인 생기면 도메인으로 교체.
ALLOWED_HOSTS=203.0.113.10

# 프론트를 VITE_API_BASE_URL="" (상대경로)로 빌드해서 nginx가 같은 origin으로
# /api를 프록시하면 브라우저 입장에서 CORS가 아예 발생하지 않아 이 값이 필요 없다.
# 그 구성을 안 쓰고 프론트를 다른 origin에서 직접 백엔드로 호출하게 할 경우에만 채울 것.
CORS_EXTRA_ORIGINS=

DB_NAME=peerbridge
DB_USER=root
DB_PASSWORD=changeme
DB_PORT=3306

# CI(.github/workflows/deploy.yml)가 push한 이미지. AWS 계정 ID/리전은 실제 값으로 교체.
ECR_IMAGE=<AWS계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com/peerbridge:latest
